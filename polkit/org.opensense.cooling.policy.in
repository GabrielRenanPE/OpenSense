<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>OpenSense</vendor>
  <icon_name>opensense</icon_name>
  <action id="org.opensense.cooling.control">
    <description>Control Acer cooling with OpenSense</description>
    <description xml:lang="pt_BR">Controlar o resfriamento Acer pelo OpenSense</description>
    <message>Cooling control requires a local active session.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@CMAKE_INSTALL_FULL_LIBEXECDIR@/opensense-fan-helper</annotate>
  </action>
</policyconfig>
